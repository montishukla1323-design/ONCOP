# ==============================================================================
# ONCOP - Production Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration
# Defaults to oncop.db in application root; on production servers, specify persistent mount path
DB_PATH=./oncop.db

# Official Government Portal Sync Gateway Settings
ENABLE_GOV_SYNC=true
CPGRAMS_PORTAL_URL=https://pgportal.gov.in
SBM_URBAN_URL=https://swachhbharatmission.gov.in
DELHI_JAL_BOARD_URL=https://delhijalboard.delhi.gov.in
URJA_MITRA_URL=https://urjamitra.in

# Session & Security
CORS_ORIGIN=*
UPLOAD_MAX_SIZE_MB=10
